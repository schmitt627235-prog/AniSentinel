    <string name="changelog_v19_title">Version 0.19 · Safe provider matching</string>
    <string name="changelog_v19_body">Conservative title variants guarded by year and format, provider enrichment for the current season, and faster title-level JustWatch matching.</string>
    <string name="changelog_v18_title">Version 0.18 · Real season source</string>
    <string name="changelog_v18_body">Exact Alarm as the sole due timer, cleanup of legacy due workers, and a complete current season derived from real AniWorld release cycles.</string>
    <string name="changelog_v17_title">Version 0.17 · Exact watcher</string>
    <string name="changelog_v17_body">Exact due and T+10 fallback alarms, release deep links, separate availability timestamps, previous and next release, and centralized streaming-provider filtering.</string>
    <string name="changelog_v16_title">Version 0.16 · Real test</string>
    <string name="changelog_v16_body">Autonomous due and availability notifications tested with real releases, expanded provider diagnostics, and transparent calendar status.</string>
    <string name="changelog_v15_title">Version 0.15 · Diagnostic</string>
    <string name="changelog_v15_body">Stable semantic notification key, visible detection time and production pages for providers, current season, dub releases, statistics and changelog.</string>
    <string name="changelog_v14_title">Version 0.14</string>
    <string name="changelog_v14_body">Fixed duplicate list-key crash, reduced Discover workload and made favorite phases exclusive.</string>
    <string name="changelog_v13_title">Version 0.13</string>
    <string name="changelog_v13_body">Added global JustWatch search and extensive catalog filters.</string>
